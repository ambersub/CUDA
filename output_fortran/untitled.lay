#!MC 1410
$!VarSet |LFDSFN1| = '"qInvariant.dat"'
$!VarSet |LFDSVL1| = '"x" "y" "z" "Q"'
$!SETSTYLEBASE FACTORY
$!PLOTOPTIONS 
